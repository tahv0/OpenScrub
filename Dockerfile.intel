# syntax=docker/dockerfile:1

# OpenScrub server image for INTEL GPUs — Quick Sync iGPUs (Gen 9+) and
# Arc discrete cards. Hardware H.264/HEVC encoding via QSV/VAAPI (fast
# HDR renders and scan copies) + ONNX inference through the OpenVINO
# execution provider (plates, person/seg, AND OCR — PP-OCRv5 det+rec via
# OnnxOcrBackend — all on the iGPU; better-than-Tesseract, GPU OCR).
#
#     docker run -d -p 8384:8384 \
#       --device /dev/dri:/dev/dri \
#       -v openscrub_data:/root/.local/share/OpenScrub \
#       ghcr.io/austinmabry/openscrub:intel        # or pharmhero/openscrub:intel
#
# --device /dev/dri is REQUIRED for GPU use — without it the container
# still works but everything runs on the CPU (the engine pre-flight
# tests every encoder with a real test encode and falls back loudly,
# never silently). On Unraid/CasaOS add the device in the template.
#
# Notes:
# - The iHD media driver covers Gen 9 (Skylake) through Arc. Very new
#   Arc cards may want a newer compute runtime than Debian ships for
#   OpenVINO GPU inference; encoding works regardless, and inference
#   falls back to OpenVINO-on-CPU (still faster than stock CPU ORT).
# - Same layout as the CPU image otherwise: data lives in the mounted
#   volume, the container is disposable, in-app updater disabled.
#
# LAYER ORDER MATTERS: heavy dependencies install BEFORE the app code is
# copied, so a release that only changes code rebuilds (and users only
# re-download) the small app layers at the bottom. Security refresh
# runs immediately before the app COPY, never after source code.

# PINNED to bookworm (not the floating python:3.12-slim, which moved to
# trixie and broke the first build): trixie DROPPED libmfx1 (the legacy
# QSV runtime for Gen 9-11 iGPUs — most of the home-server fleet) and
# intel-opencl-icd (the compute runtime OpenVINO needs for iGPU
# inference). Bookworm ships both, and its ffmpeg is built against
# libmfx (verified: libavcodec59 depends on it), so the QSV encoders
# are present. Revisit when trixie regains an Intel compute runtime.
FROM python:3.12-slim-bookworm

# Debian's non-free component carries the Intel iHD media driver; the
# QSV stack is libva -> iHD driver, dispatched from ffmpeg through
# libmfx (Gen 9-11) / libmfx-gen + libvpl (Gen 12+/Arc). intel-opencl-icd
# is the compute runtime OpenVINO uses to run inference on the iGPU.
RUN --mount=type=cache,id=openscrub-pip-intel,target=/root/.cache/pip,sharing=locked \
 sed -i 's/Components: main/Components: main contrib non-free non-free-firmware/' \
      /etc/apt/sources.list.d/debian.sources \
 && apt-get update \
 && apt-get dist-upgrade -y \
 && apt-get install -y --no-install-recommends tesseract-ocr ffmpeg \
      intel-media-va-driver-non-free libmfx1 libmfx-gen1.2 libvpl2 \
      libva-drm2 intel-opencl-icd vainfo \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --upgrade pip setuptools wheel

ENV LIBVA_DRIVER_NAME=iHD

WORKDIR /src

# Persistent pip cache mount keeps downloaded wheels across rebuilds without
# putting pip's cache inside the image. It is safe if a requirements file
# changes or BuildKit has to re-execute the install step.
# ---- heavy dependency layer: rebuilds ONLY when requirements.txt changes.
# onnxruntime-openvino REPLACES the stock onnxruntime wheel: same API,
# adds the OpenVINOExecutionProvider the engine prefers when present
# (AUTO device: iGPU/Arc when available, CPU otherwise).
COPY requirements.txt ./
RUN --mount=type=cache,id=openscrub-pip-intel,target=/root/.cache/pip,sharing=locked \
 grep -viE '^onnxruntime' requirements.txt > /tmp/req.noort \
 && pip install -r /tmp/req.noort \
 # faster-whisper: local speech transcription for spoken-PII
 # suggestions (fully offline)
 && pip install faster-whisper \
 # faster-whisper depends on STOCK onnxruntime, whose files land in the
 # same onnxruntime/ package dir and CLOBBER the OpenVINO provider (it
 # broke the v1.0.65 build the day stock 1.27 released). Evict any
 # stock wheel and install onnxruntime-openvino LAST so its files win
 # unconditionally — the assert below is the backstop.
 && (pip uninstall -y onnxruntime || true) \
 && pip install --force-reinstall --no-deps \
      onnxruntime-openvino \
 # spaCy NER for name detection, baked in with its model
 && python -m spacy download en_core_web_sm \
 # fail the build if the OpenVINO provider didn't register — an image
 # tagged :intel that silently ran plain CPU would defeat its purpose
 && python -c "import onnxruntime as ort; \
provs = ort.get_available_providers(); \
assert 'OpenVINOExecutionProvider' in provs, \
('onnxruntime OpenVINO provider missing: %r' % provs); \
print('onnxruntime', ort.__version__, '| providers', provs)"

# ---- model layer: pre-fetched detection models so first run works
# offline. In its OWN cached layer ABOVE the app code (standalone script,
# no openscrub import): a release that only changes code no longer
# re-downloads ~60MB of unchanged models. Rebuilds only when
# docker/prefetch_models.py itself changes; a sync test pins its table
# to the engine's constants.
COPY docker/prefetch_models.py ./
RUN python prefetch_models.py yunet sface vittrack ppdet pprec pprec_yml plate_t640

# ---- weekly security refresh: after large deps/models, BEFORE app code
# CI varies SECURITY_REFRESH to install OS updates. Only this step and the
# small source/app layers below rebuild; CUDA, Python wheels and downloaded
# models remain cached. Ordinary code edits keep the default value (0) and
# never need to re-run apt-get update or dist-upgrade.
ARG SECURITY_REFRESH=0
RUN --mount=type=cache,id=openscrub-pip-intel,target=/root/.cache/pip,sharing=locked \
 echo "security refresh ${SECURITY_REFRESH}" \
 && apt-get update \
 && apt-get dist-upgrade -y \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --upgrade pip setuptools wheel

# ---- app layers: tiny, change every release
COPY pyproject.toml README.md LICENSE NOTICE THIRD_PARTY_NOTICES.md plate_models.json face_models.json person_models.json ./
COPY openscrub.py openscrub_web.py stop_review.py openscrub_logging.py learning_session.py video_learning.py learned_models.py learning_candidates.py plate_verifier.py confirmed_findings.py finding_previews.py review_preview_index.py review_journal.py findings_training.py findings_web.py findings_ui.py review_similarity_ui.py plate_text_hints.py plate_text_web.py video_sections.py section_workflow.py openscrub_setup.py openscrub_update.py \
     openscrub_vault.py zones_ui.py install.py test_openscrub.py ./
COPY plate_text_subprocess.py ./
COPY assets/openscrub.ico assets/
COPY scripts/ scripts/
RUN --mount=type=cache,id=openscrub-pip-intel,target=/root/.cache/pip,sharing=locked \
 pip install --no-deps .

# tells the web UI it runs in a container: the update notice becomes
# inform-only ("pull the new image") instead of offering the in-place
# updater, whose writes would vanish on the next container recreate
ENV OPENSCRUB_IN_DOCKER=1
# Unbuffered stdout: without this, Python block-buffers prints in a non-TTY
# container and `docker logs` stays EMPTY for minutes — a real Mac user
# debugged a perfectly healthy server because the startup banner (and any
# crash traceback stuck behind it) never appeared.
ENV PYTHONUNBUFFERED=1
ENV PYTHONFAULTHANDLER=1

EXPOSE 8384
# Lets `docker ps`/Docker Desktop show whether the server actually answers
# (the reported failure looked identical whether the server was up or not).
# Scheme-agnostic: tries the default self-signed HTTPS, then --http.
HEALTHCHECK --interval=60s --timeout=10s --start-period=90s --retries=3 \
  CMD python -c "import urllib.request,ssl;\
ctx=ssl._create_unverified_context();\
exec('try:\n urllib.request.urlopen(\"https://127.0.0.1:8384/\",context=ctx,timeout=8)\nexcept Exception:\n urllib.request.urlopen(\"http://127.0.0.1:8384/\",timeout=8)')"

VOLUME ["/root/.local/share/OpenScrub"]
CMD ["openscrub-web", "--host", "0.0.0.0"]
