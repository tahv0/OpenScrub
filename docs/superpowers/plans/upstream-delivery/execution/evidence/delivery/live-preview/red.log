    def test_failed_publication_retains_bytes_cleans_up_and_retries(preview, http, monkeypatch,
                                                                  failure, prior):
        job, path, frames, expected = preview
        if prior:
            publish(job, frames[0])
        callback = web.WebCallbacks(job)
