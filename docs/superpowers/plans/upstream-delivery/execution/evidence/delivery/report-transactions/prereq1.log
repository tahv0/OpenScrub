        monkeypatch.setattr(web.OwnedIterable, 'close', close)
        def serve():
            try:
                web._serve('127.0.0.1', 0, None)
            except BaseException as error:
                errors.append(error)
                ready.set()
        thread = threading.Thread(target=serve, name='task621-cheroot')
        thread.start()
        connection = response = None
        try:
