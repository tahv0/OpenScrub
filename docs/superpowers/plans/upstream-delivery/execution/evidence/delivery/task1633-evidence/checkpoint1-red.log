                q = _out_q(codec, out_quality)
                if codec == "h264_nvenc":
                    vargs = ["-c:v", "h264_nvenc", "-preset", "p4", "-cq", q]
                elif codec == "hevc_nvenc":
                    vargs = ["-c:v", "hevc_nvenc", "-preset", "p4", "-cq", q]
                elif codec == "h264_qsv":
                    vargs = ["-c:v", "h264_qsv", "-preset", "medium",
