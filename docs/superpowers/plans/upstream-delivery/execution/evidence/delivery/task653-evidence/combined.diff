+    near = ['zzzdef#sample.invalid', 'zzzikl#sample.invalid',
+            'zzzpqr#sample.invalid', 'zzzvwx#sample.invalid']
+    exact = ['abcdef@sample.invalid', 'ghijkl@sample.invalid',
