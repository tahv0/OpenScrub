diff --git a/README.md b/README.md
index 6b09186..53a8384 100644
--- a/README.md
+++ b/README.md
@@ -888,3 +888,25 @@ wheel; the core `<5` bound cannot prevent that conflict. The standalone installe
 checks OpenCV again after Paddle, while desktop/web provider install commands
 retain their existing choices. Recheck after optional installs; neither the bound
 nor a successful import certifies mixed flavors, GPU execution, or model accuracy.
+Job messages are kept in memory as a recent history: at most 2,000 entries
+and 512 KiB of UTF-8 payload per job, with each callback entry capped at 8 KiB
+including `... [message truncated]`. Embedded newlines remain one entry;
+lone surrogates become `?`. The browser shows fixed omission/truncation notes,
+starts with the latest 400 entries, and continues appending while open.
+This does not bound browser history or total process memory, and creates no
+persistent callback log. Retry appends to the same history.
+
+`GET /api/jobs/<id>/log?from=N&epoch=E` returns absolute `from`/`len` cursors,
+`lines`, `base`, `epoch`, `reset`, `dropped` and `truncated` in one snapshot.
+`len` counts all accepted entries, including evicted entries. An epoch change,
+stale cursor or future cursor replays retained history with `reset` set to
+`epoch`, `stale` or `future` respectively; an in-range request returns its
+suffix with `reset: null`. For example, with retained interval `[100,103)`,
+`from=20` returns `from=100,len=103,reset="stale"` and three entries. Send the
+accepted epoch on later polls to detect replacement even when the new history
+has grown past the old cursor. Numeric-only callers cannot detect every such
+replacement; older browsers must reload to use the updated reset handling.
+Malformed cursors return 400; `from` and `epoch` queries are limited to 64 and
+128 characters. Job metadata keeps its latest 30 entries and absolute
+`log_len`, adding coherent `log_epoch`, `log_base`, `log_retained`, `log_bytes`,
+`log_dropped` and `log_truncated` fields.
diff --git a/openscrub_internal/job_logs.py b/openscrub_internal/job_logs.py
new file mode 100644
index 0000000..6c1e410
--- /dev/null
+++ b/openscrub_internal/job_logs.py
@@ -0,0 +1,89 @@
+"""Bounded, in-memory job messages with atomic absolute cursor snapshots.
+
+Only plain strings are accepted (TypeError otherwise, without conversion).
+Lone surrogates become '?' via UTF-8's replacement policy. Normalization
+copies at most MAX_ENTRY_BYTES codepoints before encoding, even for enormous
+inputs. Payload limits exclude caller inputs, Python overhead, detached
+snapshots, JSON escaping, and browser history. No callbacks or job locks run
+under the local store lock.
+"""
+from collections import deque
+from threading import Lock
+from uuid import uuid4
+
+MAX_ENTRIES = 2000
+MAX_BYTES = 512 * 1024
+MAX_ENTRY_BYTES = 8 * 1024
+TRUNCATION_SUFFIX = '... [message truncated]'
+
+
+class JobLog:
+    """One store per constructed job; retry keeps this store and epoch."""
+
+    def __init__(self, messages=(), *, max_entries=MAX_ENTRIES,
+                 max_bytes=MAX_BYTES, max_entry_bytes=MAX_ENTRY_BYTES):
+        if (max_entries < 1 or max_bytes < max_entry_bytes
+                or max_entry_bytes < len(TRUNCATION_SUFFIX)):
+            raise ValueError('invalid job log bounds')
+        self._max_entries = max_entries
+        self._max_bytes = max_bytes
+        self._max_entry_bytes = max_entry_bytes
+        self._entries = deque()
+        self._bytes = 0
+        self._base = 0
+        self._next = 0
+        self._truncated = 0
+        self._epoch = uuid4().hex
+        self._lock = Lock()
+        for message in messages:
+            self.append(message)
+
+    def append(self, message):
+        if type(message) is not str:
+            raise TypeError('job log message must be a plain string')
+        # Bound work and temporary storage independently of caller input size.
+        prefix = message[:self._max_entry_bytes].encode('utf-8', 'replace')
+        truncated = (len(message) > self._max_entry_bytes
+                     or len(prefix) > self._max_entry_bytes)
+        if truncated:
+            budget = self._max_entry_bytes - len(TRUNCATION_SUFFIX)
+            text = prefix[:budget].decode('utf-8', 'ignore') + TRUNCATION_SUFFIX
+        else:
+            text = prefix.decode('utf-8')
+        size = len(text.encode('utf-8'))
+        with self._lock:
+            while (len(self._entries) >= self._max_entries
+                   or self._bytes + size > self._max_bytes):
+                _, dropped_size = self._entries.popleft()
+                self._bytes -= dropped_size
+                self._base += 1
+            self._entries.append((text, size))
+            self._bytes += size
+            self._next += 1
+            self._truncated += int(truncated)
+
+    def snapshot(self, cursor=0, epoch=None, *, tail=None):
+        """Detach one coherent interval; JSON encoding belongs outside the lock.
+
+        Tail snapshots supply metadata. Cursor snapshots prioritize epoch,
+        stale, then future resets. `len` is absolute next, never deque length.
+        """
+        cursor = max(0, cursor)
+        with self._lock:
+            reset = None
+            if tail is not None:
+                start = max(self._base, self._next - tail)
+            elif epoch is not None and epoch != self._epoch:
+                start, reset = self._base, 'epoch'
+            elif cursor < self._base:
+                start, reset = self._base, 'stale'
+            elif cursor > self._next:
+                start, reset = self._base, 'future'
+            else:
+                start = cursor
+            lines = [text for i, (text, _) in enumerate(self._entries, self._base)
+                     if i >= start]
+            return {'from': start, 'lines': lines, 'len': self._next,
+                    'epoch': self._epoch, 'base': self._base, 'reset': reset,
+                    'dropped': self._base, 'truncated': self._truncated,
+                    'retained': len(self._entries), 'bytes': self._bytes}
